{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "NZWalksConnectionString": "Server=[YOUR_SERVER_NAME];Database=[YOUR_APPLICATION_DATABASE_NAME];User Id=[YOUR_USERNAME];Password=[YOUR_PASSWORD];Trusted_Connection=True;TrustServerCertificate=True;",
    "NZWalksAuthConnectionString": "Server=[YOUR_SERVER_NAME];Database=[YOUR_AUTH_DATABASE_NAME];User Id=[YOUR_USERNAME];Password=[YOUR_PASSWORD];Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Key": "[YOUR_SUPER_SECRET_KEY_MINIMUM_32_CHARACTERS]",
    "Issuer": "[YOUR_JWT_ISSUER_URL_OR_IDENTIFIER]",
    "Audience": "[YOUR_JWT_AUDIENCE_URL_OR_IDENTIFIER]"
  }
}
